NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://op2p_user:op2p_password@localhost:5432/op2p_white_label?schema=public
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=op2p_refresh_token
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SECURE=false
# For separate HTTPS frontend/backend domains use: REFRESH_COOKIE_SECURE=true and REFRESH_COOKIE_SAME_SITE=none
REFRESH_COOKIE_SAME_SITE=lax
BCRYPT_SALT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20

ONLY_P2P_BASE_URL=https://example.com
ONLY_P2P_API_ID=replace-with-only-p2p-api-id
ONLY_P2P_SECRET_KEY=replace-with-only-p2p-secret-key
ONLY_P2P_TIMEOUT_MS=10000

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_BOT_USERNAME=@p2ponlywhitelabelbot
TELEGRAM_CLIENT_ID=replace-with-telegram-client-id-from-botfather
TELEGRAM_CLIENT_SECRET=replace-with-telegram-client-secret-from-botfather
